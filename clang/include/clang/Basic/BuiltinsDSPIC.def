//===----------------------------------------------------------------------===//
//
// trellis session 103. The table read/write instructions, which are the only way to reach program
// memory for WRITING and the way the vendor's compiler reaches it for reading. Before this file
// they came from a shim header (tools/dspic-llvm/dspic-builtins.h) as `__asm__ volatile` strings,
// so this compiler had emitted `tblrdl`/`tblrdh` ZERO times -- it copied them.
//
// trellis session 108: the rest of the near-term VENDOR set -- the instructions no C expression
// spells. Every name and signature below is read off the vendor's own registration
// (xc16_gcc_831/gcc/gcc/config/pic30/pic30.c, add_builtin_function_public, TARGET_CLASSIC arm),
// not from memory; cc1's answer for each is banked at prints/l1f/isaops/vbi-ask-pre.txt.
//
// The names are the VENDOR's, not `__builtin_dspic_*`: xc16 and XC-DSC spell them exactly so, real
// firmware calls them by these names, and a port that renamed them would not compile that firmware.
//
// ⛔ `Ui` IS SIXTEEN BITS ON THIS TARGET. Session 99 found three clang builtins in this port handing
// a 16-bit `int` to an i32 intrinsic parameter; every intrinsic below takes and returns i16 (or
// i8 where the vendor's type is `unsigned char`), and `Li` -- `long`, the widening multiplies'
// result -- is the ONE 32-bit type, produced by ordinary IR extension and multiply, not by an
// intrinsic.
//
// The attribute is "n" (nothrow) and NOT "c" (const) on anything that reads TBLPAG or touches the
// machine state; "nc" on the pure ones (fbcl, the multiplies, the swaps).
//
//===----------------------------------------------------------------------===//

// The effective program address is TBLPAG:offset. tblrdl reads bits 15:0 of the program word;
// tblrdh reads bits 23:16 into the low byte of the result, zero in the high byte.
BUILTIN(__builtin_tblrdl, "UiUi", "n")
BUILTIN(__builtin_tblrdh, "UiUi", "n")

// The writes target the flash write LATCHES, not program memory: the NVM controller commits them.
BUILTIN(__builtin_tblwtl, "vUiUi", "n")
BUILTIN(__builtin_tblwth, "vUiUi", "n")

// ── trellis session 108 ─────────────────────────────────────────────────────────────────────────
// The BYTE table forms. tblrdl.b reads PM<7:0> at an even offset and PM<15:8> at an odd one;
// tblrdh.b reads PM<23:16> at an even offset and ZERO at an odd one (DS70000157G). Both take the
// page from TBLPAG like the word forms, hence "n" and not "c".
BUILTIN(__builtin_tblrdlb, "UcUi", "n")
BUILTIN(__builtin_tblrdhb, "UcUi", "n")
BUILTIN(__builtin_tblwtlb, "vUiUc", "n")
BUILTIN(__builtin_tblwthb, "vUiUc", "n")

// fbcl Ws,Wnd -- find first bit change from left: the number of leading redundant sign bits,
// NEGATED (0 for 0x4000 or 0x8000, -14 for 0x0001, -15 when no change is found), sign-extended.
// The vendor's signature is int(int); pure.
BUILTIN(__builtin_fbcl, "ii", "nc")

// The four widening 16x16->32 multiplies. ⛔ THESE ARE NOT INTRINSICS: each is an ordinary IR
// multiply of the two extended operands, and the backend selects `mul.ss`/`mul.uu` from that shape
// already (L1f-d) and `mul.su`/`mul.us` from the mixed one since this session (a target DAG combine
// on the i32 MUL of a sign-extended and a zero-extended i16). So the same instructions reach
// PLAIN C -- `(long)a * (long)b` with one signed and one unsigned operand -- which cc1 does NOT do
// (it spends five words on that C shape and one on the builtin; vbi-ask-pre.txt, c_mulsu).
BUILTIN(__builtin_mulss, "Liii", "nc")
BUILTIN(__builtin_muluu, "ULiUiUi", "nc")
BUILTIN(__builtin_mulsu, "LiiUi", "nc")
BUILTIN(__builtin_mulus, "LiUii", "nc")

// swap Wn exchanges the two bytes of a word (the ISD::BSWAP the backend already selects as `swap`);
// swap.b Wn exchanges the two NIBBLES of the low byte. The vendor spells the byte one
// `__builtin_swap_byte`.
BUILTIN(__builtin_swap, "UiUi", "nc")
BUILTIN(__builtin_swap_byte, "UcUc", "nc")

// The control instructions. `I` = the argument must be an integer constant expression (the
// instruction takes a literal; cc1 refuses a variable too). The RANGE -- disi 0..16383, pwrsav
// 0..1 -- is checked in CGBuiltin and refused with a diagnostic at the call, not silently
// truncated into the encoding. All four sit in isa-inventory.py's INTRINSIC / asm-only exclusion,
// so they move the standing coverage figure by ZERO; they exist for the firmware that calls them.
BUILTIN(__builtin_disi, "vIi", "n")
BUILTIN(__builtin_pwrsav, "vIUi", "n")
BUILTIN(__builtin_clrwdt, "v", "n")
BUILTIN(__builtin_nop, "v", "n")

// ── trellis session 118 ─────────────────────────────────────────────────────────────────────────
// The census (steps/frontend/builtin-census.py) put 93 of the vendor's 124 builtins for this
// device in state MISSING -- our clang refuses the call. These are the ones a shipping firmware
// NAMES, plus the ones cc1 lowers to a single instruction this backend already emits. Every
// signature is the vendor's own, from `xc-dsc-gcc -mprint-protos=`
// (prints/l1f/frontend/builtin-ask.protos.h), and cc1's emission for each is banked at
// prints/l1f/frontend/builtin2-ask.small.s.

// btg: toggle one bit of a place. ⛔ NO INTRINSIC AND NO BACKEND CHANGE -- `*p ^= (1u << n)` is
// already the IR shape the backend selects `btg` from (L1f-g), measured before it was written.
// The bit number is an integer constant expression (`I`): cc1 refuses a variable by name,
// "Unexpected second argument to __builtin_btg()".
// ⚠ The vendor's own first spelling takes a PLAIN `uint16_t *`; the _8/_16/_32 family takes a
// VOLATILE pointer. Both are the vendor's, not a choice here.
BUILTIN(__builtin_btg, "vUi*IUi", "n")
BUILTIN(__builtin_btg_8, "vUcD*IUi", "n")
BUILTIN(__builtin_btg_16, "vUiD*IUi", "n")
BUILTIN(__builtin_btg_32, "vULiD*IUi", "n")

// The global interrupt enable. cc1 emits `bclr _INTCON2,#15` / `bset _INTCON2,#15` followed by
// TWO NOPS -- part of the vendor's definition, not padding, exactly as write_NVM's two nops are.
BUILTIN(__builtin_disable_interrupts, "v", "n")
BUILTIN(__builtin_enable_interrupts, "v", "n")

// `reset` and `break`, one instruction each.
BUILTIN(__builtin_software_reset, "v", "n")
BUILTIN(__builtin_software_breakpoint, "v", "n")

// `repeat #n ; nop` -- ONE instruction of two asm lines, like the divide (L1f-d): nothing may be
// scheduled between a repeat and the instruction it drives. The vendor accepts a variable count
// as well as a literal, so both forms exist.
BUILTIN(__builtin_repeat_nop, "vUi", "n")

// ff1l / ff1r: find the first one from the left / right. ⛔ NOT `clz`+1 IN THE EMITTED CODE even
// though that is the value: this backend's ctlz pattern is `DEC16rr (FF1L16 x)` and going through
// it costs `cp0 ; bra z ; ff1l ; dec ; inc` against cc1's two instructions. The HARDWARE result is
// already the builtin's value -- DS70000157G p.257: 0 when no bit is set, else the shift count
// starting at 1 -- so each is its own intrinsic straight onto the instruction. The `_16`
// spellings are the SAME instruction (cc1 emits `ff1l w1,w0` for both), so they are aliases.
BUILTIN(__builtin_ff1l, "UiUi", "nc")
BUILTIN(__builtin_ff1r, "UiUi", "nc")
BUILTIN(__builtin_ff1l_16, "UiUi", "nc")
BUILTIN(__builtin_ff1r_16, "UiUi", "nc")

// ── trellis session 122: the eight RELOCATION builtins ──────────────────────────────────────────
// The four that take an OBJECT are custom-typechecked ("t") for the reason session 121's nine are:
// the argument is a pointer of ANY address space (addr_high exists for a `__prog__` object), and
// the vendor's <builtins.h> declares them unprototyped. `Ui`/`ULi`, not `Us`, to merge with the
// pack's uint16_t = unsigned int. The argument rules are cc1's (pic30.c:9987-10045), checked in
// CGBuiltinDSPIC.cpp beside the lowering: `&VAR_DECL` exactly for the addr three, a pointer wider
// than 16 bits for addr_high; dataflashoffset IS tbloffset (pic30.c:7521) and is checked no
// further than tbloffset is. The four that take a STRING are ordinary prototyped builtins whose
// types are the vendor header's own (uint32_t f(const char *); int32_t f(char *)).
BUILTIN(__builtin_addr,            "ULi", "nct")
BUILTIN(__builtin_addr_low,        "Ui",  "nct")
BUILTIN(__builtin_addr_high,       "Ui",  "nct")
BUILTIN(__builtin_dataflashoffset, "Ui",  "nct")
BUILTIN(__builtin_section_begin,   "ULicC*", "nc")
BUILTIN(__builtin_section_end,     "ULicC*", "nc")
BUILTIN(__builtin_section_size,    "ULicC*", "nc")
BUILTIN(__builtin_vector_offset,   "Lic*",   "nc")

// Three the vendor spells twice. fbcl_16 is __builtin_fbcl's instruction; swap_16 is
// __builtin_swap's; swap_8 is __builtin_swap_byte's. They add no intrinsic and no instruction.
BUILTIN(__builtin_fbcl_16, "ii", "nc")
BUILTIN(__builtin_swap_16, "UiUi", "nc")
BUILTIN(__builtin_swap_8, "UcUc", "nc")

// ── trellis session 121: the nine vendor ADDRESS OPERATORS as real builtins ──────────────────────
// Forced by the version-macro mirror: at __XC16_VERSION__ >= 1059 xc.h includes <builtins.h>, whose
// unprototyped prototypes for these nine collided with dspic-builtins.h's `overloadable` shims.
// "t" = custom typechecking, so each takes a pointer of ANY address space exactly as cc1's own
// unprototyped MD builtins do (bl_fw passes __prog__-qualified objects to edspage/edsoffset), and
// canBeRedeclared (Builtins.cpp) lists them so <builtins.h> REDECLARES rather than erroring. The
// return type is `Ui`/`ULi` -- unsigned int / unsigned long -- to MATCH the vendor's own uint16_t /
// uint32_t IN THE FIRMWARE CONTEXT: the pack's include/bits/stdint.h typedefs uint16_t = unsigned
// int (not clang's default unsigned short), so `Us` conflicts and `Ui` merges. Measured (probe4b).
// Lowered in CGBuiltinDSPIC.cpp to the shim's exact inline asm (`mov #<op>(${1:c}),$0`), byte-for-byte.
BUILTIN(__builtin_tblpage,   "Ui", "nct")
BUILTIN(__builtin_tbloffset, "Ui", "nct")
BUILTIN(__builtin_psvpage,   "Ui", "nct")
BUILTIN(__builtin_psvoffset, "Ui", "nct")
BUILTIN(__builtin_edspage,   "Ui", "nct")
BUILTIN(__builtin_edsoffset, "Ui", "nct")
BUILTIN(__builtin_dmapage,   "Ui", "nct")
BUILTIN(__builtin_dmaoffset, "Ui", "nct")
BUILTIN(__builtin_tbladdress, "ULi", "nct")

#undef BUILTIN
